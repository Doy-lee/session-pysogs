[log]
; Log level for the plugin (DEBUG, INFO, WARNING, ERROR, CRITICAL)
; Can be overridden per-plugin in [plugin_sogs_filter] as 'log_level'
level = INFO

[plugin]
; Configuration for the plugin connection to the SOGS server
sogs_address = tcp://127.0.0.1:22028
sogs_pubkey_hex = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

[plugin_sogs_filter]
; Display name for the plugin
display_name = SOGS Filter Plugin

; Path to the ed25519 private key file
key_file = plugin_sogs_filter_ed25519

; Log level for this plugin (overrides [log] section if set)
log_level = INFO

; If true, also filter moderator messages
filter_mods = false

[plugin_sogs_filter.alphabets]
; Define alphabet filter patterns as key-value pairs: filter_name = regex_pattern
; Order matters: more specific patterns should come before broader ones (e.g., persian before arabic)
persian  = [\u0621-\u0628\u062a-\u063a\u0641-\u0642\u0644-\u0648\u064e-\u0651\u0655\u067e\u0686\u0698\u06a9\u06af\u06be\u06cc]
arabic   = [\u0600-\u06ff\u0750-\u077f\u08a0-\u08ff\ufb50-\ufdff\ufe70-\ufefe]
cyrillic = [\u0400-\u04ff]

[plugin_sogs_filter.room.*]
; Global defaults for all rooms

; Enable profanity detection
profanity = false

; If true, accept message but hide from other users (shadowban)
profanity_silent = false

; Alphabets to filter (space-separated list of filter names from [alphabets] section)
alphabets = persian arabic cyrillic

; If true, silently reject alphabet violations; if false, reply with warning
alphabet_silent = false

[plugin_sogs_filter.room.*.reply.*]
; Default reply message for all filtered content. Multiple lines = random options.
; Escape sequences:
;   \@ - @mention of the user
;   \p - profile name in plain text
;   \r - room name
;   \t - room token
;   \n - line break within a single reply
;   \\ - literal backslash
reply = Please keep it clean in \r!
 Warning: Inappropriate content detected!

; Display name for the reply message
profile_name = Filter Bot

; If true, reply publicly; if false, whisper to user
public = false

[plugin_sogs_filter.room.*.reply.profanity]
; Profanity-specific replies (overrides default replies)
reply = No profanity allowed!

[plugin_sogs_filter.room.myroom]
; Room-specific settings for "myroom" room
profanity = false

[plugin_sogs_filter.room.myroom.reply.arabic]
; Room-specific and alphabet-specific replies
reply = Only Latin characters are supported here.
